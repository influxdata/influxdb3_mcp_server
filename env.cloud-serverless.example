# InfluxDB MCP Server Configuration - Cloud Serverless
# Copy this file to .env.cloud-serverless.local for local integration tests,
# or to .env for running the MCP server. Update the copy with your details.

# InfluxDB Product Type (REQUIRED)
# Must be 'cloud-serverless' for InfluxDB Cloud Serverless
INFLUX_DB_PRODUCT_TYPE=cloud-serverless

# InfluxDB Cloud Serverless URL (REQUIRED)
# Your region-specific endpoint URL from the InfluxDB Cloud console
# Example: https://us-east-9-9.aws.cloud2.influxdata.com
INFLUX_DB_INSTANCE_URL=https://your-region.aws.cloud2.influxdata.com

# InfluxDB Cloud Serverless Token (REQUIRED)
# Your database token from the InfluxDB Cloud console
# This token provides access to query and write operations
INFLUX_DB_TOKEN=your_database_token_here

# Database used by live integration tests. Use a disposable or dedicated test
# bucket. Tests don't select an arbitrary bucket when this value is set.
INFLUX_TEST_DATABASE=your_test_bucket_here

# Run npm run test:integration:cloud-serverless to load
# .env.cloud-serverless.local and run the live integration tests.
