{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/influxdata/influxdb3_mcp_server/schemas/read-only-response.schema.json",
  "title": "Read-only tool response",
  "description": "The JSON envelope the read-only tools return in their text content. query_sql and query_influxql return querySuccess; the other tools return toolSuccess; every tool returns toolError on failure. Changes are additive: new fields may be added, and existing required fields stay required.",
  "oneOf": [
    {
      "$ref": "#/definitions/querySuccess"
    },
    {
      "$ref": "#/definitions/toolSuccess"
    },
    {
      "$ref": "#/definitions/toolError"
    }
  ],
  "definitions": {
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "completeness": {
      "description": "complete: every row the query selects was returned. capped: a row bound cut the result; cap and cap_source say which. interrupted: the server failed after rows began to arrive; rows holds those received.",
      "enum": ["complete", "capped", "interrupted"]
    },
    "querySuccess": {
      "type": "object",
      "required": ["ok", "db", "q", "format", "rows", "metadata", "warnings"],
      "properties": {
        "ok": {
          "const": true
        },
        "db": {
          "type": "string"
        },
        "q": {
          "type": "string",
          "description": "The query as run, with the row bound the caller sees."
        },
        "format": {
          "description": "The format of the payload the server returned, which can differ from the one requested; a format_mismatch warning says so.",
          "enum": ["json", "jsonl", "csv"]
        },
        "rows": {
          "type": "array",
          "description": "JSON rows, or for csv and jsonl one item whose value is the text payload."
        },
        "metadata": {
          "type": "object",
          "required": [
            "request_id",
            "query_id",
            "query_id_source",
            "query_type",
            "success",
            "duration_ms",
            "row_count",
            "truncated",
            "completeness"
          ],
          "properties": {
            "request_id": {
              "type": "string"
            },
            "query_id": {
              "type": "string"
            },
            "query_id_source": {
              "enum": ["local", "system.queries.id"]
            },
            "query_type": {
              "enum": ["sql", "influxql"]
            },
            "success": {
              "type": "boolean"
            },
            "duration_ms": {
              "type": "number"
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Rows returned, or records in a csv or jsonl payload."
            },
            "truncated": {
              "type": "boolean",
              "description": "Kept for compatibility: true when completeness is not complete."
            },
            "completeness": {
              "$ref": "#/definitions/completeness"
            },
            "cap": {
              "type": "integer",
              "minimum": 0
            },
            "cap_source": {
              "enum": ["server_bound", "query_limit"]
            }
          },
          "if": {
            "properties": {
              "completeness": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "truncated": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["cap"]
                },
                {
                  "required": ["cap_source"]
                }
              ]
            }
          },
          "else": {
            "required": ["cap", "cap_source"],
            "properties": {
              "truncated": {
                "const": true
              },
              "completeness": {
                "const": "capped"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/warning"
          }
        },
        "access_outcome": {
          "enum": ["data", "empty"]
        }
      }
    },
    "toolError": {
      "type": "object",
      "required": ["ok", "error"],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "access_outcome",
            "recovery",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "fix": {
              "type": "string"
            },
            "supported_formats": {
              "type": "array",
              "items": {
                "enum": ["json", "jsonl", "csv", "pretty", "parquet"]
              }
            },
            "access_outcome": {
              "enum": [
                "not_found",
                "access_denied",
                "credential_invalid",
                "metadata_unavailable",
                "not_found_or_denied",
                "unknown"
              ]
            },
            "recovery": {
              "enum": [
                "retry",
                "narrow",
                "fix_reference",
                "renew_credential",
                "change_endpoint",
                "none"
              ]
            },
            "retry_after_ms": {
              "type": "number",
              "minimum": 0
            },
            "timeout_origin": {
              "enum": ["client"]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "recovery": {
                    "const": "retry"
                  }
                }
              },
              "then": {
                "properties": {
                  "retryable": {
                    "const": true
                  }
                }
              },
              "else": {
                "properties": {
                  "retryable": {
                    "const": false
                  }
                }
              }
            }
          ]
        },
        "rows": {
          "type": "array",
          "description": "Rows received before an interrupted result failed."
        },
        "metadata": {
          "type": "object",
          "properties": {
            "row_count": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            },
            "completeness": {
              "const": "interrupted"
            }
          }
        }
      },
      "if": {
        "required": ["rows"]
      },
      "then": {
        "required": ["metadata"],
        "properties": {
          "metadata": {
            "required": ["completeness", "row_count", "truncated"],
            "properties": {
              "truncated": {
                "const": true
              }
            },
            "type": "object"
          }
        }
      }
    },
    "toolSuccess": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": {
          "const": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "access_outcome": {
          "enum": ["data", "empty", "metadata_unavailable"]
        },
        "table_count": {
          "type": "integer",
          "minimum": 0
        },
        "table_total": {
          "type": "integer",
          "minimum": 0
        },
        "tables_truncated": {
          "type": "boolean"
        },
        "tables_failed": {
          "type": "integer",
          "minimum": 0
        },
        "tables_partial": {
          "type": "integer",
          "minimum": 0
        },
        "schema_mode": {
          "type": "object",
          "required": ["value", "source"],
          "properties": {
            "source": {
              "enum": ["server", "inferred", "unknown"]
            }
          }
        },
        "deletion": {
          "type": "object",
          "required": ["value", "source"],
          "properties": {
            "source": {
              "enum": ["server", "inferred", "unknown"]
            }
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "category", "source"],
            "properties": {
              "source": {
                "enum": ["server", "inferred", "unknown"]
              },
              "category": {
                "enum": ["time", "tag", "field", "unknown"]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["table_total"]
          },
          "then": {
            "required": [
              "table_count",
              "tables_truncated",
              "tables_failed",
              "tables_partial",
              "sample_window",
              "query_budget",
              "tables",
              "warnings"
            ],
            "properties": {
              "sample_window": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": ["start", "end", "hours"]
                  }
                ]
              },
              "tables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "status",
                    "deletion",
                    "schema_mode",
                    "warnings"
                  ],
                  "properties": {
                    "status": {
                      "enum": ["ok", "partial", "failed"]
                    },
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message",
                        "access_outcome",
                        "recovery",
                        "retryable"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "access_outcome": {
                          "enum": [
                            "not_found",
                            "access_denied",
                            "credential_invalid",
                            "metadata_unavailable",
                            "not_found_or_denied",
                            "unknown"
                          ]
                        },
                        "recovery": {
                          "enum": [
                            "retry",
                            "narrow",
                            "fix_reference",
                            "renew_credential",
                            "change_endpoint",
                            "none"
                          ]
                        },
                        "retryable": {
                          "type": "boolean"
                        },
                        "retry_after_ms": {
                          "type": "number",
                          "minimum": 0
                        },
                        "timeout_origin": {
                          "enum": ["client"]
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "recovery": {
                                "const": "retry"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "retryable": {
                                "const": true
                              }
                            }
                          },
                          "else": {
                            "properties": {
                              "retryable": {
                                "const": false
                              }
                            }
                          }
                        }
                      ]
                    },
                    "deletion": {
                      "type": "object",
                      "required": ["value", "source"],
                      "properties": {
                        "source": {
                          "enum": ["server", "inferred", "unknown"]
                        }
                      }
                    },
                    "schema_mode": {
                      "type": "object",
                      "required": ["value", "source"],
                      "properties": {
                        "source": {
                          "enum": ["server", "inferred", "unknown"]
                        }
                      }
                    },
                    "schema": {
                      "type": "object",
                      "required": [
                        "columns",
                        "schema_mode",
                        "deletion",
                        "warnings"
                      ],
                      "properties": {
                        "columns": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["name", "type", "category", "source"],
                            "properties": {
                              "source": {
                                "enum": ["server", "inferred", "unknown"]
                              },
                              "category": {
                                "enum": ["time", "tag", "field", "unknown"]
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "enum": ["partial", "failed"]
                          }
                        }
                      },
                      "then": {
                        "required": ["error"]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "enum": ["ok", "partial"]
                          }
                        }
                      },
                      "then": {
                        "required": ["schema"]
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["rows"]
          },
          "then": {
            "required": [
              "db",
              "q",
              "format",
              "rows",
              "metadata",
              "warnings",
              "access_outcome"
            ],
            "properties": {
              "metadata": {
                "type": "object",
                "required": ["request_id", "query_id", "row_count", "truncated"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["health", "ping"]
          },
          "then": {
            "properties": {
              "health": {
                "type": "object",
                "required": ["outcome"],
                "properties": {
                  "outcome": {
                    "enum": ["ok", "unreachable", "credential_cannot_check"]
                  }
                }
              },
              "ping": {
                "type": "object",
                "required": ["outcome"],
                "properties": {
                  "outcome": {
                    "enum": ["ok", "unreachable", "credential_cannot_check"]
                  }
                }
              }
            }
          }
        }
      ],
      "not": {
        "required": ["q"]
      }
    }
  }
}
