{
  "mcpServers": {
    "influxdb": {
      "command": "npx",
      "args": ["-y", "@influxdata/influxdb3-mcp-server@2.1.0"],
      "env": {
        "INFLUX_DB_INSTANCE_URL": "http://localhost:8181/",
        "INFLUX_DB_TOKEN": "<YOUR_INFLUXDB_OPERATOR_TOKEN>",
        "INFLUX_DB_PRODUCT_TYPE": "core",
        "INFLUX_MCP_TOOL_PROFILE": "readonly"
      }
    }
  }
}
